#!/bin/sh
set -eu
case "${1:-}" in
  *.tex) ;;
  *) echo 'Usage: resume-compile filename.tex' >&2; exit 2 ;;
esac
# Two passes resolve hyperlinks/references; no latexmk/Perl dependency needed.
for pass in 1 2; do
  xelatex -no-shell-escape -halt-on-error -file-line-error -interaction=nonstopmode "$1"
done
